{
  "name": "smart-pos-admin-panel",
  "version": "0.1.0",
  "description": "Restaurant administration frontend for Smart POS / Alpha POS",
  "private": true,
  "scripts": {
    "dev": "vite --port 5181 --host 0.0.0.0",
    "dev:local": "vite --port 5181 --host 127.0.0.1",
    "build": "vite build",
    "dev:owner": "vite --config vite.owner.config.ts --mode owner-dev --host 0.0.0.0",
    "build:owner": "vite build --config vite.owner.config.ts --mode owner",
    "preview": "vite preview --port 5050 --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src -c .eslintrc.js --ext .ts,.tsx,.vue",
    "lint:ci": "yarn lint --max-warnings 0",
    "smoke": "playwright test",
    "smoke:owner": "playwright test -c playwright.owner.config.ts",
    "smoke:install": "playwright install --with-deps chromium",
    "ci": "yarn lint:ci && yarn typecheck && yarn test:contract && yarn build",
    "build:icons": "tsc -b src/@iconify && node src/@iconify/build-icons.js && node scripts/build-interface-icons.cjs",
    "postinstall": "yarn build:icons",
    "lint:fix": "yarn lint --fix",
    "test:contract": "node --test tests/contract/*.test.cjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@casl/ability": "6.5.0",
    "@casl/vue": "2.2.1",
    "@floating-ui/dom": "1.2.7",
    "@iconify/vue": "4.1.1",
    "@sentry/vue": "^10.47.0",
    "@vueuse/core": "10.1.2",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.23.0",
    "axios": "1.4.0",
    "dompurify": "^3",
    "echarts": "^5",
    "highlight.js": "^11",
    "markdown-it": "^14",
    "pinia": "2.0.35",
    "vue": "3.2.47",
    "vue-echarts": "^6",
    "vue-i18n": "9.2.2",
    "vue-router": "4.1.6",
    "vue-sonner": "^2.0.9",
    "vue3-perfect-scrollbar": "1.6.1",
    "vuetify": "3.2.0",
    "webfontloader": "1.6.28"
  },
  "devDependencies": {
    "@antfu/eslint-config-vue": "0.38.5",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@iconify-json/bx": "1.1.6",
    "@iconify-json/bxl": "^1.1.5",
    "@iconify-json/bxs": "^1.1.5",
    "@iconify-json/lucide": "1.2.130",
    "@iconify-json/mdi": "1.1.50",
    "@iconify/tools": "2.2.6",
    "@intlify/unplugin-vue-i18n": "0.10.0",
    "@playwright/test": "^1.60.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "18.16.3",
    "@types/webfontloader": "1.6.35",
    "@typescript-eslint/eslint-plugin": "5.59.2",
    "@typescript-eslint/parser": "5.59.2",
    "@vitejs/plugin-vue": "4.2.1",
    "@vitejs/plugin-vue-jsx": "3.0.1",
    "eslint": "8.39.0",
    "eslint-import-resolver-typescript": "3.5.5",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-promise": "6.1.1",
    "eslint-plugin-regex": "1.10.0",
    "eslint-plugin-sonarjs": "0.19.0",
    "eslint-plugin-unicorn": "46.0.0",
    "eslint-plugin-vue": "9.11.0",
    "postcss-html": "1.5.0",
    "sass": "1.62.1",
    "stylelint": "15.6.1",
    "stylelint-config-idiomatic-order": "9.0.0",
    "stylelint-config-standard-scss": "7.0.1",
    "stylelint-use-logical-spec": "5.0.0",
    "type-fest": "3.9.0",
    "typescript": "5.0.4",
    "unplugin-auto-import": "0.15.3",
    "unplugin-vue-components": "0.24.1",
    "unplugin-vue-define-options": "1.3.4",
    "vite": "4.3.4",
    "vite-plugin-pages": "0.29.0",
    "vite-plugin-vue-layouts": "0.8.0",
    "vite-plugin-vuetify": "1.0.2",
    "vue-tsc": "1.6.3"
  },
  "packageManager": "yarn@1.22.18",
  "resolutions": {
    "postcss": "8"
  },
  "engines": {
    "node": ">=24 <25",
    "yarn": ">=1.22.18 <2"
  }
}
